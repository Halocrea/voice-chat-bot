TOKEN=
CLIENT_ID=
MAINTAINER_ID=
# Optional: deploy the slash commands to this single guild so they show up
# instantly instead of taking up to an hour to propagate globally
DEV_GUILD_ID=

# Optional. One of: error, warn, info (default), http, verbose, debug, silly.
# A level enables itself and every level above it. Note that nothing is logged
# below info today, so debug behaves exactly like info.
LOG_LEVEL=

# Optional. Discord webhook the bot posts its errors to; leave empty to turn
# alerting off. A webhook rather than the bot itself, on purpose: it still works
# when the gateway is down, which is when you most want to hear about it.
# Treat it as a secret, anyone holding it can post to that channel.
ALERT_WEBHOOK_URL=

# Optional. Dead man's switch URL (healthchecks.io or similar) pinged while the
# bot is connected to Discord. The monitor alerts you when the pings stop, which
# is the only way to learn that the bot died: a dead process sends nothing.
HEARTBEAT_URL=
# Optional, defaults to 5. Keep it below the period configured on the monitor.
HEARTBEAT_INTERVAL_MINUTES=
